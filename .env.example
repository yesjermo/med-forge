# Settings for the command-line tools (npm run cli). The web edition keeps its settings in the browser.
# ── Writer: who writes the blocks ───────────────────────────────────────────
# Default: a free model on your own computer through Ollama (https://ollama.com).
#   ollama pull qwen3        (or qwen2.5, gpt-oss, gemma3, deepseek-r1;
#                             kimi-k2:1t-cloud after `ollama signin`)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5

# Optional online writers (OpenAI-compatible). Each appears once its key is set.
OPENROUTER_API_KEY=    # GPT, Sonnet, Gemini, Qwen, Kimi…; ":free" models cost nothing: openrouter.ai/keys
GEMINI_API_KEY=        # free tier: aistudio.google.com/apikey
OPENAI_API_KEY=        # pay as you go: platform.openai.com/api-keys
# Model for the online writers (default: each provider's suggested model)
MEDFORGE_MODEL=
# Default writer: ollama (default) | openrouter | gemini | openai
MEDFORGE_WRITER=

# ── Research: who finds the papers ──────────────────────────────────────────
# Crossref is free and always on. Each of these switches on when its key is set.
ELICIT_API_KEY=        # Elicit Pro plan or above: elicit.com/developer
CONSENSUS_API_KEY=     # free plan has 30 calls/month: consensus.app/api-mcp
PERPLEXITY_API_KEY=    # pay-as-you-go: perplexity.ai/settings/api
OPENALEX_API_KEY=      # free key: openalex.org/settings/api
